# Android news bot for lemdro.id - posts RSS headlines to !android
# Managed by ansible (roles/androidnews). Never run a second copy anywhere: double posts.
# v2 is live (every 15 min). v1 remains at /opt/android-news-bot/ for rollback:
#   */30 * * * * androidnews /opt/android-news-bot/run.sh
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

*/15 * * * * androidnews /opt/android-news-bot/v2/run.sh
