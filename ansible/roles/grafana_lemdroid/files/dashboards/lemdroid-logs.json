{
  "uid": "lemdroid-logs",
  "title": "lemdro.id \u00b7 Error logs (scrubbed)",
  "tags": [
    "lemdro.id",
    "logs"
  ],
  "description": "VictoriaLogs main store on lemdroid-ovh (IP-free: client_net /24 or /48, redacted paths and queries, scrubbed SQL). The vl-ip store (full IPs) is not reachable from Grafana.",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "timezone": "browser",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "fiscalYearStartMonth": 0,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "lemdro.id"
      ],
      "asDropdown": false,
      "title": "lemdro.id",
      "includeVars": false,
      "keepTime": true
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "type": "custom",
        "name": "source",
        "label": "Source",
        "multi": true,
        "includeAll": true,
        "allValue": "*",
        "hide": 0,
        "query": "nginx,postgres,journald",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Errors",
      "collapsed": false,
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Errors per minute by source",
      "description": "nginx = 5xx responses; postgres = ERROR/FATAL/PANIC lines; journald = priority err or worse (cloudflared, docker, containerd, postgresql, telegraf, kernel).",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "lemdroid-vl"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "lemdroid-vl"
          },
          "expr": "((source:nginx status:>=500) or (source:postgres level:in(ERROR, FATAL, PANIC)) or (source:journald priority:<=3)) | stats by (source) count() errors",
          "queryType": "statsRange",
          "editorMode": "code",
          "legendFormat": "{{source}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "pointSize": 6,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "barAlignment": -1
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "nginx 5xx by route and status",
      "description": "",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "lemdroid-vl"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "lemdroid-vl"
          },
          "expr": "source:nginx status:>=500 | stats by (route, status, upstream) count() n | sort by (n desc) | limit 20",
          "queryType": "stats",
          "editorMode": "code"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
