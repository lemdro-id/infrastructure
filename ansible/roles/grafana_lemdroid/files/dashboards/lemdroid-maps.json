    {
      "type": "timeseries",
      "title": "Requests/s by country (top 10, all nginx traffic)",
      "description": "VictoriaMetrics lemdroid_nginx_requests_by_geo_total is labeled only by geo_country and ua_class. This panel counts every request in the selected user-agent classes, including federation inbox, health checks, and Cloudflare-egress networks. Unknown lookups are country ZZ. Hide datacenters does not apply: this counter has no geo_hosting label, so datacenter networks stay in the rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "lemdroid-vm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "lemdroid-vm"
          },
          "expr": "topk(10, sum by (geo_country) (rate(lemdroid_nginx_requests_by_geo_total{ua_class=~\"${ua:regex}\"}[$__rate_interval])))",
          "legendFormat": "{{geo_country}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "pointSize": 6,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "barAlignment": -1
