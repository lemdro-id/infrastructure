        "layers": [
          {
            "type": "markers",
            "name": "Countries",
            "config": {
              "showLegend": true,
              "style": {
                "color": {
                  "fixed": "blue"
                },
                "opacity": 0.5,
                "size": {
                  "field": "requests",
                  "fixed": 5,
                  "min": 3,
                  "max": 40
                },
                "symbol": {
                  "fixed": "img/icons/marker/circle.svg",
                  "mode": "fixed"
                },
                "symbolAlign": {
                  "horizontal": "center",
                  "vertical": "center"
                },
                "textConfig": {
                  "fontSize": 10,
                  "offsetX": 0,
                  "offsetY": 0,
                  "textAlign": "center",
                  "textBaseline": "middle"
                }
              }
            },
            "location": {
              "mode": "lookup",
              "lookup": "geo_country",
              "gazetteer": "public/gazetteer/countries.json"
            },
            "tooltip": true
