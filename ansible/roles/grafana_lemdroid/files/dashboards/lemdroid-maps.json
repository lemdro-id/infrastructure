{
  "uid": "lemdroid-maps",
  "title": "lemdro.id \u00b7 Maps (visitors and federation)",
  "tags": [
    "lemdro.id",
    "maps"
  ],
  "description": "Offline GeoIP of the truncated client network (/24, /48) only, done in Vector on lemdroid-ovh with DB-IP Lite City. City-level at best (DB centroid rounded to 0.1 deg). IP Geolocation by [DB-IP](https://db-ip.com) (DB-IP Lite City, CC BY 4.0). Datacenter tagging uses DB-IP Lite ASN, CC BY 4.0, same attribution.",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "5m",
  "fiscalYearStartMonth": 0,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "lemdro.id"
      ],
      "asDropdown": false,
      "title": "lemdro.id",
      "includeVars": false,
      "keepTime": true
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "type": "custom",
        "name": "ua",
        "label": "Visitors",
        "multi": true,
        "includeAll": false,
        "hide": 0,
        "query": "browser,app,other,bot_or_tool,none",
        "current": {
          "text": [
            "browser",
            "app"
          ],
          "value": [
            "browser",
            "app"
          ]
        },
        "options": [
          {
            "text": "browser",
            "value": "browser",
            "selected": true
          },
          {
            "text": "app",
            "value": "app",
            "selected": true
          },
          {
            "text": "other",
            "value": "other",
            "selected": false
          },
          {
            "text": "bot_or_tool",
            "value": "bot_or_tool",
            "selected": false
          },
          {
            "text": "none",
            "value": "none",
            "selected": false
          }
        ],
        "description": "User-agent class (federation servers are on the federation map, not here)."
      },
      {
        "type": "custom",
        "name": "hide_datacenters",
        "label": "Hide datacenters",
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "query": "on : -geo_hosting:true,off : *",
        "current": {
          "text": "on",
          "value": "-geo_hosting:true",
          "selected": true
        },
        "options": [
          {
            "text": "on",
            "value": "-geo_hosting:true",
            "selected": true
          },
          {
            "text": "off",
            "value": "*",
            "selected": false
          }
        ],
        "description": "On drops visitor rows with geo_hosting true (datacenter/cloud ASN). A row with no geo_hosting field, logged before ASN enrichment, still shows. Federation panels are not filtered."
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Visitors",
      "collapsed": false,
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "geomap",
      "title": "Visitors by country (circle size = requests)",
      "description": "Excludes federation (inbox), health checks and Cloudflare-egress networks (WARP/Workers). Hide datacenters (default on) also drops geo_hosting true; a row with no geo_hosting field still shows. Tooltip shows distinct /24 (or /48) networks too. IP Geolocation by [DB-IP](https://db-ip.com) (DB-IP Lite City, CC BY 4.0).",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "lemdroid-vl"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "lemdroid-vl"
          },
          "expr": "source:nginx ${hide_datacenters} ua_class:in(${ua:csv}) -route_class:in(inbox, health) -geo_cdn:cloudflare geo_country:* | stats by (geo_country) count() requests, count_uniq(client_net) networks",
          "queryType": "stats",
          "editorMode": "code"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns",
            "valueLabel": "__name__"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "renameByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "view": {
          "id": "zero",
          "lat": 25,
          "lon": 0,
          "zoom": 1.6,
          "allLayers": true
