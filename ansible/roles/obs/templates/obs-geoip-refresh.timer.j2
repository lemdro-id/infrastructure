# {{ ansible_managed }} (role obs). DB-IP publishes the Lite DB monthly; a weekly check picks it up within 7 days.
[Unit]
Description=lemdro.id obs: GeoIP database refresh, weekly (Wed 05:17 UTC)

[Timer]
OnCalendar=Wed *-*-* 05:17:00 UTC
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
