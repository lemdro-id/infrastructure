# /root/pictrs/pictrs.env on the VPS (chmod 600). Names only here; never commit values.
# Same value as `pictrs.api_key` in /root/lemmy/config.hjson
PICTRS__SERVER__API_KEY=
# Backblaze B2 application key for bucket `lemdroid`
PICTRS__STORE__ACCESS_KEY=
PICTRS__STORE__SECRET_KEY=
# postgres://pictrs:<password>@127.0.0.1:5432/pictrs
PICTRS__REPO__URL=
